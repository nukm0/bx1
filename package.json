{
  "name": "baraholka-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @baraholka/api\" \"npm run dev -w @baraholka/web\"",
    "build": "npm run build -w @baraholka/web",
    "db:generate": "npm run db:generate -w @baraholka/api",
    "db:migrate": "npm run db:migrate -w @baraholka/api",
    "db:seed": "npm run db:seed -w @baraholka/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}